# Copy this file to .env and fill in real values - .env is gitignored,
# this .example file is not, so it documents the shape without the secret.

# Same value as backend/.env's SETU_API_KEY - the listener authenticates to
# the backend exactly like the React frontend does.
SETU_API_KEY=

# Where the backend lives. Use http://127.0.0.1:8000 to test against your
# local dev backend, or https://setu-w2gk.onrender.com to send real intake
# into the deployed app.
BACKEND_URL=http://127.0.0.1:8000
